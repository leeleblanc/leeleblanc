# frozen_string_literal: true

source "https://rubygems.org"

# 📦 ONE DEPENDENCY. No theme gem and no plugins — the feed, the sitemap and
# robots.txt are Liquid templates in this repository, so there is nothing
# here that can be abandoned out from under the site.
#
# The version is pinned to a major so a `bundle update` cannot silently move
# to Jekyll 5 and change how something renders on a day you were publishing.
gem "jekyll", "~> 4.4"

# Ruby 3.4 removed these from the default gems. Declaring them keeps the
# build working on a newer Ruby than the one it was written on, which is the
# whole point of pinning anything.
gem "base64"
gem "csv"
gem "logger"
gem "bigdecimal"

# Windows and JRuby only; harmless elsewhere. `:windows` replaces the old
# :mingw/:x64_mingw/:mswin triple, which Bundler now warns is going away.
gem "tzinfo-data", platforms: [:windows, :jruby]
