---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- comment -%}
  🗂 Every page that is really a page, plus every post. `sitemap: false` in
  a page's front matter keeps it out. The XML files themselves are skipped
  by testing the output extension rather than by naming them, so a file
  added later cannot forget to exclude itself.
{%- endcomment -%}
{%- for page in site.pages %}
  {%- unless page.sitemap == false or page.url contains '404' %}
  {%- assign ext = page.url | split: '.' | last %}
  {%- unless ext == 'xml' or ext == 'txt' %}
  <url>
    <loc>{{ page.url | absolute_url | xml_escape }}</loc>
    {%- if page.last_modified_at %}
    <lastmod>{{ page.last_modified_at | date_to_xmlschema }}</lastmod>
    {%- endif %}
  </url>
  {%- endunless %}
  {%- endunless %}
{%- endfor %}
{%- for post in site.posts %}
  {%- unless post.sitemap == false %}
  <url>
    <loc>{{ post.url | absolute_url | xml_escape }}</loc>
    <lastmod>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</lastmod>
  </url>
  {%- endunless %}
{%- endfor %}
</urlset>
