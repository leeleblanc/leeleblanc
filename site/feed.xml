---
# 📡 A hand-written Atom feed, so the site needs no jekyll-feed gem.
# `layout: null` is load-bearing: _config.yml gives every file the `page`
# layout by default, and without this line the feed would be wrapped in
# the site's HTML and served as a broken document.
layout: null
permalink: /feed.xml
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title | xml_escape }}</title>
  {%- if site.description %}
  <subtitle>{{ site.description | strip_html | normalize_whitespace | xml_escape }}</subtitle>
  {%- endif %}
  <link rel="self" type="application/atom+xml" href="{{ '/feed.xml' | absolute_url | xml_escape }}"/>
  <link rel="alternate" type="text/html" href="{{ '/' | absolute_url | xml_escape }}"/>
  <id>{{ '/' | absolute_url | xml_escape }}</id>
  {%- comment -%}
    Atom requires a feed-level <updated>. The newest post's date is the
    honest answer; with no posts yet, the build time is.
  {%- endcomment -%}
  {%- if site.posts.size > 0 %}
  <updated>{{ site.posts.first.date | date_to_xmlschema }}</updated>
  {%- else %}
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  {%- endif %}
  {%- if site.author %}
  <author><name>{{ site.author | xml_escape }}</name></author>
  {%- endif %}
  <generator uri="https://jekyllrb.com/">Jekyll</generator>
{%- for post in site.posts limit: 25 %}
  <entry>
    <title>{{ post.title | xml_escape }}</title>
    <link rel="alternate" type="text/html" href="{{ post.url | absolute_url | xml_escape }}"/>
    <id>{{ post.url | absolute_url | xml_escape }}</id>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</updated>
    {%- if post.description %}
    <summary>{{ post.description | strip_html | normalize_whitespace | xml_escape }}</summary>
    {%- endif %}
    {%- for tag in post.tags %}
    <category term="{{ tag | xml_escape }}"/>
    {%- endfor %}
    <content type="html">{{ post.content | strip_newlines | xml_escape }}</content>
  </entry>
{%- endfor %}
</feed>
